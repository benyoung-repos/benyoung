# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Claude Code local settings — ignore everything under .claude/ EXCEPT
# the shared settings.json (hooks, project-wide config) and the shared
# agents directory (custom subagent definitions like the employer
# reviewer). Both should be tracked so the setup survives a fresh clone.
.claude/*
!.claude/settings.json
!.claude/agents
!.claude/agents/**

# Vercel CLI local project state
.vercel

# environment variable overrides (covers .env.local, .env.development, etc.)
.env*

# private brief materials (CVs, client docs, notes handed to the assistant)
Claude briefs/
