---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page not found - Ben Young"
	description="The page you were looking for is not here. Head back to the home page or drop me a line."
>
	<div style="position:relative;background:radial-gradient(120% 80% at 8% -10%, var(--color-glow) 0%, transparent 55%), radial-gradient(90% 60% at 100% 100%, rgba(233,232,226,0.07) 0%, transparent 60%), linear-gradient(var(--color-bg1), var(--color-bg2));color:var(--color-ink);font-family:var(--font-sans);min-height:100vh;display:flex;flex-direction:column">

		<header style="display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 48px;font-family:var(--font-mono);font-size:12px;border-bottom:1px solid var(--color-rule)">
			<a href="/" style="font-family:var(--font-serif);font-size:17px;text-decoration:none;color:inherit">Ben Young</a>
			<a href="/#contact" style="border-bottom:1px solid var(--color-rule2);padding-bottom:2px;color:inherit;text-decoration:none">Get in touch</a>
		</header>

		<main style="flex:1;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px;padding:96px 48px;align-items:baseline">
			<div style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
				<span style="color:var(--color-acc);font-family:var(--font-mono);font-style:normal;font-size:11px">404</span>Not found
			</div>
			<div style="max-width:60ch">
				<h1 style="margin:0;font-family:var(--font-serif);font-weight:400;font-size:clamp(44px,5.6vw,72px);line-height:1.05;letter-spacing:-0.02em;color:var(--color-ink)">
					This page isn't <span style="font-style:italic;color:var(--color-acc)">here.</span>
				</h1>
				<p style="margin:28px 0 0;font-size:16px;line-height:1.68;color:var(--color-ink3);max-width:46ch">
					It may have moved, or it may never have existed. Either way, the two links below will get you somewhere useful.
				</p>
				<div style="margin-top:40px;display:flex;gap:32px;flex-wrap:wrap;font-family:var(--font-mono);font-size:13px">
					<a href="/" style="color:var(--color-ink2);text-decoration:none;border-bottom:1px solid var(--color-rule2);padding-bottom:2px">← Home</a>
					<a href="/#contact" style="color:var(--color-ink2);text-decoration:none;border-bottom:1px solid var(--color-rule2);padding-bottom:2px">Get in touch →</a>
				</div>
			</div>
		</main>
	</div>
</Layout>
