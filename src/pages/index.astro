---
import Layout from '../layouts/Layout.astro';

const rotatingClients = [
	'Channel 4',
	'WWF',
	'The Royal Society',
	'the UN Environment Programme',
	'the Royal College of Surgeons',
	'Vodafone',
	'the Department for Education',
];

const selectedClients = [
	'Channel 4',
	'WWF',
	'Philips',
	'UN Environment Programme',
	'The Royal Society',
	'Royal College of Surgeons',
	'Vodafone',
	'Department for Education',
	'UNEP Finance Initiative',
	'ISEAL Alliance',
	'Global Canopy',
];

const doing = [
	{
		kind: 'UX & product design',
		body: 'Discovery, information architecture, wireframing, prototyping, interface and visual design, design systems, usability testing.',
	},
	{
		kind: 'AI-assisted development',
		body: 'Designing and building production websites and web apps end-to-end with AI. Taking products from concept to live without the cost or lead time of a development team.',
	},
	{
		kind: 'AI & automation',
		body: 'Multi-agent workflows, AI content pipelines, image generation, API integrations, business automations.',
	},
	{
		kind: 'Consultancy & auditing',
		body: 'UX and website audits, positioning, go-to-market and AI search visibility (AEO / GEO) audits with prioritised roadmaps clients can act on.',
	},
];

const work = [
	{
		year: '2025 —',
		role: 'Co-founder',
		title: 'Bookbag',
		subtitle: 'A marketplace connecting brands with UK primary schools',
		body: 'Designed and built the marketing site and the web application end-to-end with three user roles — brand, school, and admin — without a development team. React, Vite, TypeScript, Tailwind, deployed on Vercel. Educational activity content produced through a custom AI image-generation and print fulfilment pipeline.',
	},
	{
		year: '2025',
		role: 'Founder, Cernago',
		title: 'Automated content pipeline',
		subtitle: 'A multi-agent AI system for research, writing and publishing',
		body: 'Multi-agent system covering research, writing, review and image generation. Publishes hands-free with no manual step. Designed and built solo.',
	},
];

const rotatingClientsForA11y = rotatingClients.join(', ');
---

<Layout>
	<div class="min-h-screen">
		<header class="px-6 md:px-12 pt-8 pb-24">
			<nav class="flex items-center justify-between font-mono text-xs uppercase tracking-widest text-ink-muted">
				<span class="text-ink">Ben Young</span>
				<a href="#contact" class="hover:text-ink transition-colors duration-300">Get in touch</a>
			</nav>
		</header>

		<section class="px-6 md:px-12 pb-40">
			<h1 class="font-display font-normal text-[clamp(2.75rem,8vw,8rem)] leading-[0.95] tracking-[-0.03em] text-balance max-w-[18ch]">
				<span class="sr-only">Twenty-one years designing the web for organisations including {rotatingClientsForA11y}.</span>
				<span aria-hidden="true">
					Twenty-one years<br />
					designing the web<br />
					for <span id="rotating-client" class="italic">Channel 4</span>.
				</span>
			</h1>
			<p class="mt-16 max-w-2xl font-display italic text-2xl md:text-3xl leading-snug text-ink">
				Now founding, and building end-to-end with AI.
			</p>
			<p class="mt-10 font-mono text-xs uppercase tracking-widest text-ink-muted">
				Available fractional, remote — two to three days a week
			</p>
		</section>

		<section class="hairline-t px-6 md:px-12 py-24">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-y-16 gap-x-8">
				<h2 class="md:col-span-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
					What I do
				</h2>
				<dl class="md:col-span-9 space-y-0">
					{
						doing.map((item, i) => (
							<div class:list={['grid grid-cols-1 md:grid-cols-9 gap-4 py-8', i > 0 && 'hairline-t']}>
								<dt class="md:col-span-3 font-display italic text-2xl leading-tight">
									{item.kind}
								</dt>
								<dd class="md:col-span-6 text-lg leading-relaxed text-ink">
									{item.body}
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="hairline-t px-6 md:px-12 py-24">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-y-16 gap-x-8">
				<h2 class="md:col-span-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
					Selected work
				</h2>
				<div class="md:col-span-9 space-y-24">
					{
						work.map((item) => (
							<article class="grid grid-cols-1 md:grid-cols-9 gap-y-6 gap-x-8">
								<p class="md:col-span-3 font-mono text-xs uppercase tracking-widest tabular text-ink-muted">
									<span>{item.year}</span>
									<span class="mx-2">·</span>
									<span>{item.role}</span>
								</p>
								<div class="md:col-span-6 space-y-5">
									<h3 class="font-display text-5xl md:text-6xl leading-[1] tracking-[-0.02em]">
										{item.title}
									</h3>
									<p class="font-display italic text-xl text-ink-muted leading-snug">
										{item.subtitle}
									</p>
									<p class="text-lg leading-relaxed text-ink pt-2">
										{item.body}
									</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="hairline-t px-6 md:px-12 py-20">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-y-8 gap-x-8">
				<h2 class="md:col-span-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
					Selected clients
				</h2>
				<p class="md:col-span-9 font-display text-2xl md:text-3xl leading-snug text-ink text-balance">
					{selectedClients.join(' · ')}
				</p>
			</div>
		</section>

		<section id="contact" class="hairline-t px-6 md:px-12 pt-24 pb-32">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-y-8 gap-x-8">
				<h2 class="md:col-span-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
					Get in touch
				</h2>
				<div class="md:col-span-9">
					<p class="font-display text-4xl md:text-6xl leading-[1] tracking-[-0.02em]">
						<a
							href="mailto:ben@benyoung.me"
							class="border-b border-current pb-1 hover:text-accent transition-colors duration-300"
						>
							ben@benyoung.me
						</a>
					</p>
					<p class="mt-10 font-mono text-xs uppercase tracking-widest text-ink-muted">
						Bournemouth, UK
						<span class="mx-2">·</span>
						<a href="tel:+447788100874" class="hover:text-ink transition-colors">07788 100874</a>
						<span class="mx-2">·</span>
						<a href="https://linkedin.com/in/bensyoung" class="hover:text-ink transition-colors">LinkedIn</a>
					</p>
				</div>
			</div>
		</section>

		<footer class="hairline-t px-6 md:px-12 py-8">
			<p class="font-mono text-xs uppercase tracking-widest text-ink-faint">
				© Ben Young {new Date().getFullYear()}
			</p>
		</footer>
	</div>

	<script>
		const el = document.getElementById('rotating-client');
		if (el) {
			const clients = [
				'Channel 4',
				'WWF',
				'The Royal Society',
				'the UN Environment Programme',
				'the Royal College of Surgeons',
				'Vodafone',
				'the Department for Education',
			];

			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reduced) {
				const HOLD_MS = 2400;
				const CHAR_STAGGER_MS = 28;
				const CHAR_ENTER_MS = 260;
				const CHAR_EXIT_MS = 140;
				const CHAR_EXIT_STAGGER_MS = 14;

				const easeOut = 'cubic-bezier(0.16, 1, 0.3, 1)';
				const easeIn = 'cubic-bezier(0.7, 0, 0.84, 0)';

				let i = 0;

				function render(text: string) {
					if (!el) return;
					el.textContent = '';
					const chars = [...text];
					chars.forEach((ch, idx) => {
						const span = document.createElement('span');
						span.textContent = ch === ' ' ? ' ' : ch;
						span.style.display = 'inline-block';
						span.style.opacity = '0';
						span.style.transform = 'translateY(0.35em)';
						span.style.transition = `opacity ${CHAR_ENTER_MS}ms ${easeOut} ${idx * CHAR_STAGGER_MS}ms, transform ${CHAR_ENTER_MS}ms ${easeOut} ${idx * CHAR_STAGGER_MS}ms`;
						el.appendChild(span);
					});
					requestAnimationFrame(() => {
						el.querySelectorAll('span').forEach((span) => {
							(span as HTMLElement).style.opacity = '1';
							(span as HTMLElement).style.transform = 'translateY(0)';
						});
					});
					return chars.length * CHAR_STAGGER_MS + CHAR_ENTER_MS;
				}

				function exit(cb: () => void) {
					if (!el) return;
					const spans = el.querySelectorAll('span');
					spans.forEach((span, idx) => {
						const s = span as HTMLElement;
						s.style.transition = `opacity ${CHAR_EXIT_MS}ms ${easeIn} ${idx * CHAR_EXIT_STAGGER_MS}ms, transform ${CHAR_EXIT_MS}ms ${easeIn} ${idx * CHAR_EXIT_STAGGER_MS}ms`;
						s.style.opacity = '0';
						s.style.transform = 'translateY(-0.35em)';
					});
					setTimeout(cb, CHAR_EXIT_MS + spans.length * CHAR_EXIT_STAGGER_MS);
				}

				function replaceInitialWithSpans() {
					const text = el?.textContent ?? '';
					render(text);
				}

				function tick() {
					exit(() => {
						i = (i + 1) % clients.length;
						const enterDuration = render(clients[i]) ?? 0;
						setTimeout(tick, HOLD_MS + enterDuration);
					});
				}

				replaceInitialWithSpans();
				const firstEnter = (el.textContent?.length ?? 0) * CHAR_STAGGER_MS + CHAR_ENTER_MS;
				setTimeout(tick, HOLD_MS + firstEnter);
			}
		}
	</script>
</Layout>
