---
import Layout from '../../layouts/Layout.astro';
import { visibleProjects } from '../../data/projects';

export function getStaticPaths() {
	return visibleProjects.map((p) => ({
		params: { slug: p.slug },
		props: { project: p },
	}));
}

const { project } = Astro.props;
const heroImage = project.hero ?? project.thumb;

// Next/prev navigation — wraps around at the ends so there's
// always something to move to.
const idx = visibleProjects.findIndex((p) => p.slug === project.slug);
const prev = visibleProjects[(idx - 1 + visibleProjects.length) % visibleProjects.length];
const next = visibleProjects[(idx + 1) % visibleProjects.length];
---

<Layout
	title={`${project.client} — Ben Young`}
	description={project.summary}
	image={heroImage}
	type="article"
>
	<div style="position:relative;background:radial-gradient(120% 80% at 8% -10%, var(--color-glow) 0%, transparent 55%), radial-gradient(90% 60% at 100% 100%, rgba(233,232,226,0.07) 0%, transparent 60%), linear-gradient(var(--color-bg1), var(--color-bg2));color:var(--color-ink);font-family:var(--font-sans);min-height:100vh">

		<header data-pad style="position:sticky;top:0;z-index:10;backdrop-filter:blur(6px);background:var(--color-head);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 48px;font-family:var(--font-mono);font-size:12px;border-bottom:1px solid var(--color-rule);animation:fade .8s ease both">
			<div style="display:inline-flex;align-items:baseline;gap:10px;min-width:0">
				<a href="/" class="home-back" style="font-family:var(--font-serif);font-size:17px;text-decoration:none;color:inherit;flex:none">Ben Young</a>
				<span data-hide-sm aria-hidden="true" style="font-family:var(--font-serif);font-size:17px;color:var(--color-ink4)">–</span>
				<span data-hide-sm style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4);white-space:nowrap">Designer and AI Consultant</span>
			</div>
			<div style="display:flex;align-items:center;gap:26px">
				<span data-hide-sm style="display:flex;align-items:center;gap:10px;color:var(--color-ink4)">
					<span style="width:9px;height:9px;border-radius:50%;background:var(--color-available);box-shadow:0 0 12px rgba(52,211,153,0.55);display:block;animation:pulse 3.2s ease-in-out infinite"></span>
					<span>available 2–3 days a week</span>
				</span>
				<a href="/work" style="border-bottom:1px solid var(--color-rule2);padding-bottom:2px">Work</a>
				<a href="/#contact" style="border-bottom:1px solid var(--color-rule2);padding-bottom:2px">Get in touch</a>
			</div>
		</header>

		<main>
		<article>
			<!-- Case study hero -->
			<section data-pad style="padding:56px 48px 40px">
				<a
					href="/work"
					class="in-page-back"
					style="display:inline-flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;color:var(--color-ink4);text-decoration:none;margin-bottom:44px;transition:color 200ms ease"
				>
					<span class="in-page-back-arrow" aria-hidden="true" style="transition:transform 200ms ease">←</span>
					<span>Back to work</span>
				</a>
				<p style="margin:0 0 20px;font-family:var(--font-mono);font-size:11px;color:var(--color-acc);letter-spacing:0.04em">
					Case study
					{project.workingWith && <span style="color:var(--color-ink4);margin-left:8px">· Working with {project.workingWith}</span>}
				</p>
				<h1 style="margin:0;font-family:var(--font-serif);font-weight:400;font-size:clamp(48px,8vw,120px);line-height:1;letter-spacing:-0.03em;max-width:14ch;animation:rise .8s cubic-bezier(.2,.7,.2,1) both;animation-delay:.1s">
					{project.client}
				</h1>
				<p style="margin:28px 0 0;font-family:var(--font-serif);font-style:italic;font-size:clamp(20px,2.4vw,30px);line-height:1.28;color:var(--color-ink4);max-width:32ch">
					{project.title}
				</p>
				<p style="margin:32px 0 0;font-family:var(--font-mono);font-size:12px;color:var(--color-ink4);letter-spacing:0.02em">
					{project.role}
				</p>
			</section>

			<!-- Primary image -->
			<section data-pad style="padding:40px 48px 40px">
				<div style="max-width:1100px;margin-left:auto;margin-right:auto;position:relative;width:100%;aspect-ratio:16/10;background:rgba(233,232,226,0.04);border:1px solid var(--color-rule);overflow:hidden">
					<img
						src={heroImage}
						alt={`${project.client} — ${project.title}`}
						style="display:block;width:100%;height:100%;object-fit:cover"
					/>
				</div>
			</section>

			<!-- Body copy -->
			<section data-sec data-pad style="padding:32px 48px 40px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
				<h2 style="margin:0;font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
					Background
				</h2>
				<div style="max-width:60ch">
					{
						project.body.map((para) => (
							<p style="margin:0 0 18px;font-size:17px;line-height:1.68;color:var(--color-ink2)">
								{para}
							</p>
						))
					}
					{
						project.liveUrl && (
							<p style="margin:28px 0 0">
								<a
									href={project.liveUrl}
									target="_blank"
									rel="noopener"
									style="font-family:var(--font-serif);font-style:italic;font-size:20px;color:var(--color-acc);border-bottom:1px solid var(--color-acc);padding-bottom:2px"
								>
									Visit the live site ↗
								</a>
							</p>
						)
					}
				</div>
			</section>

			<!-- Gallery (optional). Click any image to enlarge into the
			     modal below via View Transitions. -->
			{
				project.gallery && project.gallery.length > 0 && (
					<section data-sec data-pad style="border-top:1px solid var(--color-rule);padding:64px 48px 80px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
						<h2 style="margin:0;font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
							Gallery
						</h2>
						<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:24px;max-width:1100px">
							{project.gallery.map((src, i) => (
								<button
									type="button"
									class="gallery-tile"
									data-gallery-open
									data-src={src}
									data-alt={`${project.client} — supporting image ${i + 1}`}
									aria-label={`Enlarge supporting image ${i + 1}`}
									style="all:unset;cursor:zoom-in;display:block;position:relative;width:100%;aspect-ratio:16/10;background:rgba(233,232,226,0.04);border:1px solid var(--color-rule);overflow:hidden;transition:border-color 300ms ease"
								>
									<img
										src={src}
										alt={`${project.client} — supporting image ${i + 1}`}
										loading="lazy"
										style="display:block;width:100%;height:100%;object-fit:cover"
									/>
								</button>
							))}
						</div>
					</section>
				)
			}

			<!-- Prev / Next navigation -->
			<nav aria-label="More case studies" data-pad style="border-top:1px solid var(--color-rule);padding:48px 48px 32px;display:grid;grid-template-columns:1fr 1fr;gap:32px;max-width:1100px;margin-left:auto;margin-right:auto">
				<a href={`/work/${prev.slug}`} style="text-decoration:none;color:inherit">
					<p style="margin:0 0 8px;font-family:var(--font-mono);font-size:11px;color:var(--color-ink4);letter-spacing:0.04em">← Previous</p>
					<p style="margin:0;font-family:var(--font-serif);font-size:22px;line-height:1.2">{prev.client}</p>
				</a>
				<a href={`/work/${next.slug}`} style="text-decoration:none;color:inherit;text-align:right">
					<p style="margin:0 0 8px;font-family:var(--font-mono);font-size:11px;color:var(--color-ink4);letter-spacing:0.04em">Next →</p>
					<p style="margin:0;font-family:var(--font-serif);font-size:22px;line-height:1.2">{next.client}</p>
				</a>
			</nav>
		</article>
		</main>

		<footer data-pad style="border-top:1px solid var(--color-rule);padding:22px 48px;display:flex;justify-content:space-between;gap:24px;font-family:var(--font-mono);font-size:12px;color:var(--color-ink4)">
			<span>© Ben Young {new Date().getFullYear()}</span>
			<a href="/work">← All work</a>
		</footer>
	</div>

	<!-- Enlarge-image modal. Uses the native <dialog> element for
	     built-in focus lock + Escape-to-close behaviour. Backdrop is
	     styled via the ::backdrop pseudo. The zoom animation uses the
	     View Transitions API when available, so the thumbnail
	     morphs smoothly into the fullscreen image. In browsers
	     without support, the modal still opens (just without the
	     morph) — see the feature check in the script. -->
	<dialog
		id="image-modal"
		style="background:transparent;border:0;padding:0;max-width:none;max-height:none;width:100vw;height:100vh;color:var(--color-ink)"
	>
		<button
			type="button"
			id="image-modal-close"
			aria-label="Close"
			style="all:unset;cursor:pointer;position:absolute;top:24px;right:24px;z-index:2;width:44px;height:44px;border-radius:50%;background:rgba(23,24,27,0.6);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:14px;color:var(--color-ink)"
		>
			✕
		</button>
		<div id="image-modal-surface" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:48px;box-sizing:border-box;cursor:zoom-out">
			<img
				id="image-modal-img"
				alt=""
				style="display:block;max-width:100%;max-height:100%;object-fit:contain"
			/>
		</div>
	</dialog>

	<style>
		.in-page-back:hover {
			color: var(--color-acc);
		}
		.in-page-back:hover .in-page-back-arrow {
			transform: translateX(-4px);
		}
		.gallery-tile:hover {
			border-color: var(--color-acc) !important;
		}
		#image-modal::backdrop {
			background: rgba(15, 16, 18, 0.85);
			backdrop-filter: blur(12px);
		}
		#image-modal[open] {
			animation: modalFade 240ms ease both;
		}
		@keyframes modalFade {
			from { opacity: 0; }
			to { opacity: 1; }
		}
		/* View-transition names: only set during the transition itself,
		   via JS. The names below are the fallback in case the JS-set
		   inline style is ever missing — a shared name lets the browser
		   morph elements between the two DOM states. */
		::view-transition-old(gallery-zoom),
		::view-transition-new(gallery-zoom) {
			animation-duration: 340ms;
			animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		}
		@media (prefers-reduced-motion: reduce) {
			#image-modal[open] { animation: none; }
			::view-transition-old(gallery-zoom),
			::view-transition-new(gallery-zoom) { animation-duration: 0s; }
		}
	</style>

	<script>
		type DocWithVT = Document & {
			startViewTransition?: (cb: () => void) => { finished: Promise<void> };
		};

		const dialog = document.getElementById('image-modal') as HTMLDialogElement | null;
		const modalImg = document.getElementById('image-modal-img') as HTMLImageElement | null;
		const modalSurface = document.getElementById('image-modal-surface');
		const closeBtn = document.getElementById('image-modal-close');
		const openers = document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]');
		const galleryList = Array.from(openers);

		let sourceEl: HTMLElement | null = null;
		let currentIndex = -1;

		function withTransition(cb: () => void) {
			const doc = document as DocWithVT;
			if (typeof doc.startViewTransition === 'function') {
				return doc.startViewTransition(cb).finished;
			}
			cb();
			return Promise.resolve();
		}

		async function openModal(btn: HTMLButtonElement) {
			if (!dialog || !modalImg) return;
			const src = btn.dataset.src ?? '';
			const alt = btn.dataset.alt ?? '';
			modalImg.src = src;
			modalImg.alt = alt;
			sourceEl = btn;
			currentIndex = galleryList.indexOf(btn);
			// Set matching view-transition-name on the source and the
			// destination for this one transition, then clean up after.
			btn.style.viewTransitionName = 'gallery-zoom';
			modalImg.style.viewTransitionName = 'gallery-zoom';
			await withTransition(() => {
				dialog.showModal();
			});
			// Clean up on the source; leave it on the modal image so
			// subsequent nav / close transitions can find it.
			btn.style.viewTransitionName = '';
		}

		// Cycle to the next / previous image in the gallery. Modal
		// img retains its view-transition-name so the src swap
		// crossfades via the View Transitions API. sourceEl updates
		// so a subsequent close morphs back to whichever thumbnail
		// is currently on show.
		async function navGallery(delta: number) {
			if (!modalImg || currentIndex < 0 || galleryList.length < 2) return;
			const next = (currentIndex + delta + galleryList.length) % galleryList.length;
			const nextBtn = galleryList[next];
			await withTransition(() => {
				modalImg.src = nextBtn.dataset.src ?? '';
				modalImg.alt = nextBtn.dataset.alt ?? '';
			});
			currentIndex = next;
			sourceEl = nextBtn;
		}

		async function closeModal() {
			if (!dialog || !modalImg) return;
			if (sourceEl) {
				sourceEl.style.viewTransitionName = 'gallery-zoom';
			}
			modalImg.style.viewTransitionName = 'gallery-zoom';
			await withTransition(() => {
				dialog.close();
			});
			if (sourceEl) {
				sourceEl.style.viewTransitionName = '';
				sourceEl = null;
			}
			modalImg.style.viewTransitionName = '';
			modalImg.src = '';
			currentIndex = -1;
		}

		openers.forEach((btn) => {
			btn.addEventListener('click', () => openModal(btn));
		});

		closeBtn?.addEventListener('click', closeModal);
		modalSurface?.addEventListener('click', (e) => {
			// Click on the surface (backdrop area) closes; clicks on the
			// image itself don't close (they'd hit the img, not surface).
			if (e.target === modalSurface) closeModal();
		});

		// <dialog> native Escape → close event. Intercept so we route
		// through the View Transitions path instead of the raw .close().
		dialog?.addEventListener('cancel', (e) => {
			e.preventDefault();
			closeModal();
		});

		// Keyboard nav — left / right when the modal is open cycle
		// through the gallery. Only bind on document rather than
		// dialog so the arrow keys work regardless of focus target
		// inside the modal.
		document.addEventListener('keydown', (e) => {
			if (!dialog?.open) return;
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				navGallery(-1);
			} else if (e.key === 'ArrowRight') {
				e.preventDefault();
				navGallery(1);
			}
		});
	</script>
</Layout>
