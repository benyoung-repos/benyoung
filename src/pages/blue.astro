---
// Cyan-accent variant of the homepage. Identical structure and type
// to `/` — the only difference is the accent colour: cyan (#00A2C7)
// replaces oxblood wherever the shared component references
// --color-accent. Overridden here on a wrapper div via inline
// style so the swap doesn't require any change to the shared
// Homepage component.
import Layout from '../layouts/Layout.astro';
import Homepage from '../components/Homepage.astro';
---

<Layout>
	<div style="--color-accent: var(--color-accent-alt);">
		<Homepage />
	</div>
</Layout>
