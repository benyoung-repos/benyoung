<style>
	/* Client-work card hover — softly tints the image-slot border and
	   the client name to the butter accent. Uses the CSS-variable
	   pattern (`.work-card:hover { --work-border: … }`) so it can
	   defeat the inline `border:` shorthand on the child element,
	   which would otherwise win on specificity. Transitions live in
	   the inline styles on the child elements themselves. */
	.work-card:hover {
		--work-border: var(--color-acc);
		--work-title: var(--color-acc);
	}

	/* Rail nav buttons (← / →) — same pattern: swap two CSS vars on
	   :hover; the buttons' inline color and border-color both read
	   those vars, so the fallback-then-hover cascade works cleanly. */
	[data-rail-prev]:hover,
	[data-rail-next]:hover {
		--btn-color: var(--color-acc);
		--btn-border: var(--color-acc);
	}

	/* About-paragraph text links — text and arrow both read
	   --link-color inline. Wrapping <span data-link-group> covers
	   both children so hover fires whether the mouse is on the anchor
	   or the arrow. Anchor keeps its yellow underline at rest. */
	[data-link-group]:hover {
		--link-color: var(--color-acc);
	}
</style>

<script>
	// --- Rail scroller (client-work section) --------------------------
	const scroller = document.querySelector<HTMLElement>('[data-scroller]');
	const railPrev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
	const railNext = document.querySelector<HTMLButtonElement>('[data-rail-next]');

	function scrollRail(dir: -1 | 1) {
		if (!scroller) return;
		scroller.scrollBy({
			left: dir * Math.min(scroller.clientWidth * 0.8, 460),
			behavior: 'smooth',
		});
	}

	railPrev?.addEventListener('click', () => scrollRail(-1));
	railNext?.addEventListener('click', () => scrollRail(1));

	// --- Mouse drag-to-swipe on the rail ------------------------------
	// Native touch swipe already works via `overflow-x: auto` +
	// scroll-snap-type on the rail element. This handler adds the same
	// gesture for desktop pointer input. Uses pointer events so it
	// covers mouse, pen, and any touch device that reports as pointer.
	if (scroller) {
		let isDragging = false;
		let startX = 0;
		let startScrollLeft = 0;
		let savedSnap = '';
		const DRAG_THRESHOLD_PX = 4; // ignore micro-jitters so real clicks still work

		scroller.style.cursor = 'grab';

		scroller.addEventListener('pointerdown', (e) => {
			// Left/primary button only.
			if (e.button !== 0) return;
			isDragging = true;
			startX = e.clientX;
			startScrollLeft = scroller.scrollLeft;
			savedSnap = scroller.style.scrollSnapType;
			// scroll-snap fights a drag mid-motion (snaps back to the
			// nearest card constantly). Disable during drag, restore on
			// pointerup so the browser snaps to rest afterwards.
			scroller.style.scrollSnapType = 'none';
			scroller.style.cursor = 'grabbing';
			scroller.setPointerCapture(e.pointerId);
		});

		scroller.addEventListener('pointermove', (e) => {
			if (!isDragging) return;
			const walk = e.clientX - startX;
			if (Math.abs(walk) < DRAG_THRESHOLD_PX) return;
			e.preventDefault();
			scroller.scrollLeft = startScrollLeft - walk;
		});

		function endDrag(e: PointerEvent) {
			if (!isDragging) return;
			isDragging = false;
			scroller!.style.cursor = 'grab';
			scroller!.style.scrollSnapType = savedSnap;
			if (scroller!.hasPointerCapture(e.pointerId)) {
				scroller!.releasePointerCapture(e.pointerId);
			}
		}

		scroller.addEventListener('pointerup', endDrag);
		scroller.addEventListener('pointercancel', endDrag);
	}

	// --- IntersectionObserver: toggle data-inview for animated elements
	// Uses the design's rootMargin (-18% top and bottom) so animations
	// fire once the element is properly in the reading zone, not just
	// touching the viewport edge.
	//
	// Some animations should play once and stay (the client-work card
	// ripple, and the availability icon's drop-and-bounce) — for those,
	// we unobserve after firing so data-inview never gets removed on
	// scroll-out and the animation doesn't reset each time the section
	// re-enters view. Other animations (heading tint, name sweep, arrow
	// nudge, email sweep) re-arm on re-entry.
	const RUN_ONCE = new Set(['track', 'landing', 'illus']);

	const io = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				const anim = entry.target.getAttribute('data-anim') ?? '';
				if (entry.isIntersecting) {
					entry.target.setAttribute('data-inview', '1');
					if (RUN_ONCE.has(anim)) {
						io.unobserve(entry.target);
					}
				} else if (!RUN_ONCE.has(anim)) {
					entry.target.removeAttribute('data-inview');
				}
			}
		},
		{ threshold: 0, rootMargin: '-18% 0px -18% 0px' }
	);

	function watch() {
		document.querySelectorAll('[data-anim]').forEach((el) => {
			if (el.getAttribute('data-anim') === 'track' && el.hasAttribute('data-inview')) return;
			io.observe(el);
		});
	}
	watch();
	// Retry once — some elements may render slightly after initial JS
	// because of font loading / layout shifts.
	setTimeout(watch, 600);
</script>
