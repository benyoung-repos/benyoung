---
// Homepage — faithful translation of the "Ben Young Portfolio Rebuild"
// design handoff (2026-07-25). Structure, copy, spacing, motion and
// timings are copied verbatim from the reference `.dc.html`. Inline
// styles are used throughout to preserve 1:1 fidelity with the source;
// refactoring to Tailwind utilities later is safe but not required.
//
// Design tokens and keyframes live in src/styles/global.css. Behaviour
// that requires JS — the IntersectionObserver, the rail scroller, the
// rail unlock timeout — is at the bottom of this file.

const projects = [
	{
		client: 'Philips',
		year: '2024',
		title: 'B2B product site and design system',
		blurb: 'Interface design and a component system for a multi-market product site, handed over as a working front end.',
		role: 'UX / UI / build',
	},
	{
		client: 'Solstice AV',
		year: '2025',
		title: 'Website design, build and AI search visibility',
		blurb: 'Positioning, a new site designed and built end to end, and an AEO/GEO audit with a prioritised roadmap.',
		role: 'Positioning / design / build',
	},
	{
		client: 'Wholegood',
		year: '2024',
		title: 'Ordering experience audit and roadmap',
		blurb: 'UX audit of the trade ordering journey, with prioritised fixes and prototypes for the highest-value changes.',
		role: 'UX audit / prototypes',
	},
	{
		client: 'Osmond Ergonomics',
		year: '2023',
		title: 'Product site rebuild',
		blurb: 'Information architecture, interface design and build for a specialist catalogue with a complex product set.',
		role: 'IA / UI / build',
	},
];

const clientList = [
	'Channel 4',
	'WWF',
	'Philips',
	'UN Environment Programme',
	'The Royal Society',
	'Royal College of Surgeons',
	'Vodafone',
	'Department for Education',
	'UNEP Finance Initiative',
	'ISEAL Alliance',
	'Global Canopy',
];
---

<div style="position:relative;background:radial-gradient(120% 80% at 8% -10%, var(--color-glow) 0%, transparent 55%), radial-gradient(90% 60% at 100% 100%, rgba(233,232,226,0.07) 0%, transparent 60%), linear-gradient(var(--color-bg1), var(--color-bg2));color:var(--color-ink);font-family:var(--font-sans);min-height:100vh">

	<!-- Header (sticky, translucent) -->
	<header data-pad style="position:sticky;top:0;z-index:10;backdrop-filter:blur(6px);background:var(--color-head);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 48px;font-family:var(--font-mono);font-size:12px;border-bottom:1px solid var(--color-rule);animation:fade .8s ease both">
		<a href="#top" style="font-family:var(--font-serif);font-size:17px">Ben Young</a>
		<div style="display:flex;align-items:center;gap:26px">
			<span data-hide-sm style="display:flex;align-items:center;gap:8px;color:var(--color-ink4)">
				<span style="width:6px;height:6px;border-radius:50%;background:var(--color-acc);display:block;animation:pulse 3.2s ease-in-out infinite"></span>
				<span>available 2–3 days a week</span>
			</span>
			<a href="mailto:ben@benyoung.me" style="border-bottom:1px solid var(--color-rule2);padding-bottom:2px">Get in touch</a>
		</div>
	</header>

	<!-- Hero -->
	<section id="top" data-hero data-pad style="padding:104px 48px 84px">
		<h1
			aria-label="Twenty years designing the web, end to end."
			style="margin:0;font-family:var(--font-serif);font-weight:400;font-size:clamp(54px,9vw,132px);line-height:1.04;letter-spacing:-0.028em;max-width:14ch;animation:rise .9s cubic-bezier(.2,.7,.2,1) both;animation-delay:.12s"
		>
			<span style="display:block">Twenty years</span>
			<span aria-hidden="true" style="display:block;height:1.24em;overflow:hidden;font-style:italic;color:var(--color-acc)">
				<span data-cycle style="display:block">
					<span style="display:block;height:1.24em;line-height:1.24">designing</span>
					<span style="display:block;height:1.24em;line-height:1.24">prototyping</span>
					<span style="display:block;height:1.24em;line-height:1.24">building</span>
					<span style="display:block;height:1.24em;line-height:1.24">shipping</span>
					<span style="display:block;height:1.24em;line-height:1.24">auditing</span>
					<span style="display:block;height:1.24em;line-height:1.24">directing</span>
					<span style="display:block;height:1.24em;line-height:1.24">consulting</span>
					<span style="display:block;height:1.24em;line-height:1.24">launching</span>
					<span style="display:block;height:1.24em;line-height:1.24">designing</span>
				</span>
			</span>
			<span style="display:block">the web, end to end.</span>
		</h1>
		<div style="margin-top:58px;height:1px;background:var(--color-ink);opacity:0.22;transform-origin:left;animation:wipe 1s cubic-bezier(.5,0,.1,1) both;animation-delay:.3s"></div>
		<p style="margin:0;padding-top:22px;font-family:var(--font-serif);font-style:italic;font-size:clamp(20px,2.1vw,28px);line-height:1.28;animation:rise .8s cubic-bezier(.2,.7,.2,1) both;animation-delay:.42s">
			Now founding, and building with AI.
		</p>
	</section>

	<!-- 01 About -->
	<section data-sec data-pad style="border-top:1px solid var(--color-rule);padding:64px 48px 76px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
		<div style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
			<span style="color:var(--color-acc);font-family:var(--font-mono);font-style:normal;font-size:11px">01</span>About
		</div>
		<div style="max-width:780px">
			<p style="margin:0;font-size:17px;line-height:1.68;max-width:60ch;color:var(--color-ink2)">
				Ben Young is a design and AI consultant based in Bournemouth, UK. Twenty years in digital, most of it in senior design roles at agencies working with the likes of Channel 4, WWF, the UN Environment Programme and The Royal Society. Now founder of <span data-link-group><a href="https://cernago.com" target="_blank" rel="noopener" style="color:var(--link-color, var(--color-ink));border-bottom:1px solid var(--color-acc);transition:color 200ms ease">Cernago</a><span style="font-size:0.72em;color:var(--link-color, var(--color-ink));margin-left:2px;vertical-align:0.18em;transition:color 200ms ease">↗</span></span> and co-founder of <span data-link-group><a href="https://bookbagmedia.com" target="_blank" rel="noopener" style="color:var(--link-color, var(--color-ink));border-bottom:1px solid var(--color-acc);transition:color 200ms ease">Bookbag</a><span style="font-size:0.72em;color:var(--link-color, var(--color-ink));margin-left:2px;vertical-align:0.18em;transition:color 200ms ease">↗</span></span>, designing and building products end to end with AI — without a development team.
			</p>
			<div style="margin-top:44px;position:relative;padding-left:26px">
				<div data-anim="rule" style="position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--color-acc);transform:scaleY(0);transform-origin:top"></div>
				<!-- Icon: available.svg (from src/assets/), inlined so the stroke
				     colour inherits from `color: var(--color-acc)`. Original file
				     used stroke:#000000; here strokes are set on the outer <svg>
				     via `stroke="currentColor"` and inherit through all children.
				     data-anim="landing" triggers a delayed drop-in-and-bounce
				     that starts once the left rule has finished growing. -->
				<svg
					data-anim="landing"
					aria-hidden="true"
					width="48"
					height="48"
					viewBox="0 0 682.66669 682.66669"
					fill="none"
					stroke="currentColor"
					stroke-width="15"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-miterlimit="10"
					style="display:block;margin-bottom:16px;color:var(--color-acc)"
				>
					<title>Available</title>
					<g transform="matrix(1.3333333,0,0,-1.3333333,0,682.66667)">
						<g transform="translate(57.502,229.4629)"><path d="m 0,0 19.288,50.644 c 0.394,0.963 1.758,0.965 2.154,0.002 L 40.556,0"/></g>
						<g transform="translate(63.5166,242.0762)"><path d="M 0,0 H 28.622"/></g>
						<g transform="translate(155.6377,229.4629)"><path d="m 0,0 19.288,50.644 c 0.395,0.963 1.759,0.965 2.154,0.002 L 40.556,0"/></g>
						<g transform="translate(161.6533,242.0762)"><path d="M 0,0 H 28.622"/></g>
						<g transform="translate(278.833,229.4629)"><path d="m 0,0 19.289,50.644 c 0.394,0.963 1.758,0.965 2.154,0.002 L 40.556,0"/></g>
						<g transform="translate(284.8486,242.0762)"><path d="M 0,0 H 28.622"/></g>
						<g transform="translate(240.3457,280.8301)"><path d="m 0,0 v -51.323 c 0.567,-0.098 17.987,0 17.987,0"/></g>
						<g transform="translate(392.957,280.8301)"><path d="m 0,0 v -51.323 c 0.567,-0.098 17.987,0 17.987,0"/></g>
						<g transform="translate(217.124,280.8301)"><path d="M 0,0 V -51.367"/></g>
						<g transform="translate(456.4033,280.5957)"><path d="M 0,0 H -21.446 V -50.898 H 0"/></g>
						<g transform="translate(454.8223,255.1465)"><path d="M 0,0 H -19.865"/></g>
						<g transform="translate(366.3125,269.0107)"><path d="m 0,0 c 0,-6.527 -5.292,-11.819 -11.819,-11.819 -3.238,0 -14.921,-0.053 -14.921,-0.053 V 0 11.819 h 14.921 C -5.292,11.819 0,6.528 0,0 Z"/></g>
						<g transform="translate(370.9258,243.3506)"><path d="m 0,0 c 0,-7.636 -6.19,-13.826 -13.827,-13.826 -3.787,0 -17.527,-0.062 -17.527,-0.062 V 0 13.826 h 17.527 C -6.19,13.826 0,7.636 0,0 Z"/></g>
						<g transform="translate(107.7373,280.8301)"><path d="m 0,0 17.562,-50.596 c 0.369,-1.036 1.837,-1.025 2.191,0.015 l 16.771,50.487"/></g>
						<g transform="translate(159.8066,175.8389)"><path d="m 0,0 h -135.407 c -9.333,0 -16.9,7.566 -16.9,16.899 v 126.524 c 0,9.333 7.567,16.899 16.9,16.899 h 463.201 c 9.333,0 16.899,-7.566 16.899,-16.899 V 16.899 C 344.693,7.566 337.127,0 327.794,0 H 192.387"/></g>
						<g transform="translate(71.6289,336.1611)"><path d="M 0,0 168.339,104.21"/></g>
						<g transform="translate(440.3711,336.1611)"><path d="M 0,0 -168.339,104.21"/></g>
						<g transform="translate(272.0322,440.3711)"><path d="m 0,0 c 0,8.854 -7.178,16.032 -16.032,16.032 -8.855,0 -16.032,-7.178 -16.032,-16.032 0,-8.854 7.177,-16.032 16.032,-16.032 C -7.178,-16.032 0,-8.854 0,0 Z"/></g>
						<g transform="translate(328.1455,127.7422)"><path d="m 0,0 c 0,-39.845 -32.301,-72.146 -72.146,-72.146 -39.844,0 -72.145,32.301 -72.145,72.146 0,39.845 32.301,72.145 72.145,72.145 C -32.301,72.145 0,39.845 0,0 Z"/></g>
						<g transform="translate(223.9355,127.7422)"><path d="M 0,0 24.048,-24.049 64.129,16.032"/></g>
					</g>
				</svg>
				<p style="margin:0;font-family:var(--font-serif);font-style:italic;color:var(--color-acc);font-size:clamp(23px,2.7vw,32px);line-height:1.3;max-width:21ch;text-wrap:pretty">
					Available two or three days a week for teams that need a senior operator in the design–product–AI corner.
				</p>
				<p style="margin:16px 0 0;font-size:14px;color:var(--color-ink4)">
					Fractional, remote, alongside Cernago and Bookbag.
				</p>
			</div>
		</div>
	</section>

	<!-- 02 What I do -->
	<section data-sec data-pad style="border-top:1px solid var(--color-rule);padding:64px 48px 76px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
		<div style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
			<span style="color:var(--color-acc);font-family:var(--font-mono);font-style:normal;font-size:11px">02</span>What I do
		</div>
		<div style="display:grid;max-width:900px">
			<div data-row style="display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr);gap:40px;padding:24px 0;border-top:1px solid var(--color-rule)">
				<h3 data-anim="head" style="margin:0;font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:22px;animation-delay:0s">UX & product design</h3>
				<p style="margin:0;font-size:15px;line-height:1.62;color:var(--color-ink3);max-width:52ch">
					Discovery, information architecture, wireframing, prototyping, interface and visual design, design systems, usability testing.
				</p>
			</div>
			<div data-row style="display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr);gap:40px;padding:24px 0;border-top:1px solid var(--color-rule)">
				<h3 data-anim="head" style="margin:0;font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:22px;animation-delay:1s">AI-assisted development</h3>
				<p style="margin:0;font-size:15px;line-height:1.62;color:var(--color-ink3);max-width:52ch">
					Designing and building production sites, web apps and multi-agent AI systems end to end. Content pipelines, image generation and workflow automations included. Concept to live without the cost or lead time of a development team.
				</p>
			</div>
			<div data-row style="display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr);gap:40px;padding:24px 0;border-top:1px solid var(--color-rule);border-bottom:1px solid var(--color-rule)">
				<h3 data-anim="head" style="margin:0;font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:22px;animation-delay:2s">Consultancy & auditing</h3>
				<p style="margin:0;font-size:15px;line-height:1.62;color:var(--color-ink3);max-width:52ch">
					UX and website audits, positioning, go-to-market, and AI search visibility (AEO / GEO) audits with prioritised roadmaps clients can act on.
				</p>
			</div>
		</div>
	</section>

	<!-- Philosophy band (unnumbered) -->
	<section data-sec data-pad style="border-top:1px solid var(--color-rule);background:rgba(230,196,85,0.035);padding:78px 48px 84px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
		<div style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4)"></div>
		<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:56px;align-items:center;max-width:1000px">
			<!-- Diagram: three concentric squares — sketch, build, ship — on a
			     dotted grid. Each layer fades in one at a time (grid, then
			     outer dashed, then middle outline, then inner filled), keyed
			     off data-anim="illus" via the IntersectionObserver. Grid is
			     now an absolutely-positioned layer of its own so its opacity
			     can animate independently of the squares layered above it. -->
			<div aria-hidden="true" data-anim="illus" style="position:relative;width:100%;max-width:340px;aspect-ratio:1;display:flex;align-items:center;justify-content:center">
				<div data-illus-layer="0" style="position:absolute;inset:0;background-image:radial-gradient(var(--color-rule) 1px, transparent 1px);background-size:22px 22px;background-position:6px 6px"></div>
				<div data-illus-layer="1" style="position:relative;width:78%;aspect-ratio:1;border:1px dashed var(--color-ink4);display:flex;align-items:center;justify-content:center">
					<div data-illus-layer="2" style="width:66%;aspect-ratio:1;border:1px solid var(--color-ink3);background:rgba(233,232,226,0.04);display:flex;align-items:center;justify-content:center">
						<div data-illus-layer="3" style="width:52%;aspect-ratio:1;background:var(--color-acc)"></div>
					</div>
				</div>
			</div>
			<div>
				<p style="margin:0;font-family:var(--font-serif);font-weight:400;font-size:clamp(30px,3.6vw,46px);line-height:1.16;letter-spacing:-0.015em;color:var(--color-ink)">
					Design is finished<br />when it <span style="font-style:italic;color:var(--color-acc)">ships.</span>
				</p>
				<p style="margin:26px 0 0;font-size:16px;line-height:1.68;color:var(--color-ink3);max-width:46ch">
					AI-assisted build lets one person hold the whole loop: ideate, prototype, polish, build, deploy. Faster feedback, tighter iteration, and the design that ships is the design that was drawn.
				</p>
			</div>
		</div>
	</section>

	<!-- 03 Client work — horizontally scrolling rail -->
	<section id="clients" style="border-top:1px solid var(--color-rule);padding:64px 0 76px">
		<div data-sec data-pad style="display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px;padding:0 48px;align-items:start">
			<div style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
				<span style="color:var(--color-acc);font-family:var(--font-mono);font-style:normal;font-size:11px">03</span>Client work
			</div>
			<div style="display:flex;align-items:baseline;justify-content:space-between;gap:24px">
				<p style="margin:0;font-size:16px;line-height:1.6;color:var(--color-ink3);max-width:46ch">
					Recent delivery for retained and project clients.
				</p>
				<div style="display:flex;gap:8px;flex:none">
					<button type="button" data-rail-prev aria-label="Previous projects" style="width:34px;height:34px;border-radius:50%;border:1px solid var(--btn-border, var(--color-rule));background:transparent;color:var(--btn-color, var(--color-ink3));cursor:pointer;font-size:14px;line-height:1;transition:color 240ms ease, border-color 240ms ease">←</button>
					<button type="button" data-rail-next aria-label="Next projects" style="width:34px;height:34px;border-radius:50%;border:1px solid var(--btn-border, var(--color-rule));background:transparent;color:var(--btn-color, var(--color-ink3));cursor:pointer;font-size:14px;line-height:1;transition:color 240ms ease, border-color 240ms ease">→</button>
				</div>
			</div>
		</div>
		<div data-rail data-scroller data-pad style="margin-top:40px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-padding-left:48px;scroll-padding-right:48px;scroll-behavior:smooth;padding:0 48px 14px">
			<div data-anim="track" style="display:flex;gap:28px">
				{
					projects.map((p, i) => (
						<article class="work-card" style={`flex:none;width:min(78vw,420px);scroll-snap-align:start;--card-delay:${i * 200}ms`}>
							<div style="position:relative;width:100%;aspect-ratio:16/10;background:rgba(233,232,226,0.04);border:1px solid var(--work-border, var(--color-rule));display:flex;align-items:center;justify-content:center;transition:border-color 300ms ease">
								<span style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink4)">Project screen</span>
							</div>
							<div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-top:18px">
								<h3 style="margin:0;font-family:var(--font-serif);font-weight:400;font-size:26px;letter-spacing:-0.01em;color:var(--work-title, var(--color-ink));transition:color 300ms ease">{p.client}</h3>
								<span style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink4)">{p.year}</span>
							</div>
							<p style="margin:8px 0 0;font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4)">{p.title}</p>
							<p style="margin:12px 0 0;font-size:14px;line-height:1.6;color:var(--color-ink3)">{p.blurb}</p>
							<p style="margin:14px 0 0;font-family:var(--font-mono);font-size:11px;color:var(--color-ink4)">{p.role}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 04 What I run -->
	<section id="work" data-sec data-pad style="border-top:1px solid var(--color-rule);padding:64px 48px 76px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
		<div style="font-family:var(--font-serif);font-style:italic;font-size:17px;color:var(--color-ink4);display:flex;align-items:baseline;gap:12px">
			<span style="color:var(--color-acc);font-family:var(--font-mono);font-style:normal;font-size:11px">04</span>What I run
		</div>
		<div style="display:grid;max-width:900px">
			<a
				href="https://bookbagmedia.com"
				target="_blank"
				rel="noopener"
				style="display:grid;grid-template-columns:minmax(0,150px) minmax(0,1fr);gap:40px;padding:36px 0;border-top:1px solid var(--color-rule)"
			>
				<div style="font-family:var(--font-mono);font-size:12px;color:var(--color-ink4);line-height:1.9">
					<div>2025 —</div>
					<div>Co-founder</div>
				</div>
				<div>
					<div style="display:flex;align-items:baseline;gap:14px">
						<h3 style="margin:0;font-family:var(--font-serif);font-weight:400;font-size:clamp(36px,4.6vw,56px);line-height:1;letter-spacing:-0.02em">Bookbag</h3>
						<span data-anim="arrow" style="display:inline-block;font-size:20px;color:var(--color-acc)">↗</span>
					</div>
					<p style="margin:14px 0 0;font-family:var(--font-serif);font-style:italic;font-size:20px;color:var(--color-ink4)">The advertising channel that funds primary schools</p>
					<p style="margin:20px 0 0;font-size:15px;line-height:1.66;color:var(--color-ink3);max-width:56ch">
						Bookbag turns brand marketing spend into direct funding for primary schools — £1,800–3,600 a year per school, in no-strings revenue that would otherwise have gone to Meta or Google. Trusted businesses reach families through printed activity resources vetted by every school before print, with zero data collected from students or families.
					</p>
					<div style="display:flex;flex-wrap:wrap;gap:6px 12px;margin-top:22px;font-family:var(--font-mono);font-size:11px;color:var(--color-ink4)">
