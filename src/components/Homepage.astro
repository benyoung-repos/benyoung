	<!-- 05 Get in touch -->
	<section id="contact" data-sec data-pad style="scroll-margin-top:80px;border-top:1px solid var(--color-rule);padding:72px 48px 92px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px">
