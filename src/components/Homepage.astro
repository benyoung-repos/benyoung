<script>
	// --- Rail scroller (client-work section) --------------------------
	const scroller = document.querySelector<HTMLElement>('[data-scroller]');
	const railPrev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
	const railNext = document.querySelector<HTMLButtonElement>('[data-rail-next]');

	function scrollRail(dir: -1 | 1) {
		if (!scroller) return;
		scroller.scrollBy({
			left: dir * Math.min(scroller.clientWidth * 0.8, 460),
			behavior: 'smooth',
		});
	}

	railPrev?.addEventListener('click', () => scrollRail(-1));
	railNext?.addEventListener('click', () => scrollRail(1));

	// --- IntersectionObserver: toggle data-inview for animated elements
	// Uses the design's rootMargin (-18% top and bottom) so animations
	// fire once the element is properly in the reading zone, not just
	// touching the viewport edge. The client-work track is a special
	// case: it fires once and never re-arms; after 2.5s the rail is
	// unlocked so the user can scroll it manually.
	let unlockTimer: ReturnType<typeof setTimeout> | undefined;

	const io = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.setAttribute('data-inview', '1');
					if (entry.target.getAttribute('data-anim') === 'track') {
						const rail = entry.target.parentElement;
						if (rail) {
							clearTimeout(unlockTimer);
							rail.removeAttribute('data-unlocked');
							// Unlock ~200ms after the entry animation completes
							// (0.15s delay + 1.5s duration + small buffer).
							unlockTimer = setTimeout(() => rail.setAttribute('data-unlocked', '1'), 1850);
						}
						io.unobserve(entry.target);
					}
				} else if (entry.target.getAttribute('data-anim') !== 'track') {
					entry.target.removeAttribute('data-inview');
				}
			}
		},
		{ threshold: 0, rootMargin: '-18% 0px -18% 0px' }
	);

	function watch() {
		document.querySelectorAll('[data-anim]').forEach((el) => {
			if (el.getAttribute('data-anim') === 'track' && el.hasAttribute('data-inview')) return;
			io.observe(el);
		});
	}
	watch();
	// Retry once — some elements may render slightly after initial JS
	// because of font loading / layout shifts.
	setTimeout(watch, 600);
</script>
