<style>
	/* Client-work card hover — softly tints the image-slot border and
	   the client name to the butter accent. Uses the CSS-variable
	   pattern (`.work-card:hover { --work-border: … }`) so it can
	   defeat the inline `border:` shorthand on the child element,
	   which would otherwise win on specificity. Transitions live in
	   the inline styles on the child elements themselves. */
	.work-card:hover {
		--work-border: var(--color-acc);
		--work-title: var(--color-acc);
	}

	/* Rail nav buttons (← / →) — same pattern: swap two CSS vars on
	   :hover; the buttons' inline color and border-color both read
	   those vars, so the fallback-then-hover cascade works cleanly. */
	[data-rail-prev]:hover,
	[data-rail-next]:hover {
		--btn-color: var(--color-acc);
		--btn-border: var(--color-acc);
	}

	/* About-paragraph text links — text and arrow both read
	   --link-color inline. Wrapping <span data-link-group> covers
	   both children so hover fires whether the mouse is on the anchor
	   or the arrow. Anchor keeps its yellow underline at rest. */
	[data-link-group]:hover {
		--link-color: var(--color-acc);
	}

	/* Homepage "View all work" link — small hover nudge on the arrow
	   and a tint on the text + underline. Mirrors the pattern used
	   by the ↗ glyphs on About-paragraph venture links. */
	.view-all:hover {
		color: var(--color-acc);
		border-color: var(--color-acc);
	}
	.view-all:hover .view-all-arrow {
		transform: translateX(4px);
	}
</style>

<script>
	// The whole setup below runs inside init(), which fires on both
	// the initial page load and after every ClientRouter navigation
	// (via astro:page-load). Without this the observers get attached
	// to the first homepage visit's DOM elements — when the user
	// navigates to a case study and comes back, the new homepage
	// DOM has no observers and animations never trigger. Old
	// observers are disconnected via the previousCleanup closure
	// so they don't accumulate across navigations.
	let previousCleanup: (() => void) | null = null;

	function init() {
	// If this page has no animation-tagged elements, we're on another
	// route (e.g. /work, /404) — skip setup entirely.
	//
	// Historical note: this used to look for the client-work rail
	// elements. When the rail was extracted out to ClientWork.astro
	// and hidden, that guard began bailing on the homepage itself
	// (rail elements were gone, so the check misfired), which killed
	// every IntersectionObserver-driven animation on the homepage.
	// Detecting via [data-anim] survives with or without the rail.
	if (!document.querySelector('[data-anim]')) return;

	// --- Rail scroller (client-work section) --------------------------
	// These may be null when ClientWork is not rendered; the handlers
	// below use optional chaining and internal null checks so it's safe.
	const scroller = document.querySelector<HTMLElement>('[data-scroller]');
	const railPrev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
	const railNext = document.querySelector<HTMLButtonElement>('[data-rail-next]');

	// Tear down any observers from the previous visit to this page.
	previousCleanup?.();
	previousCleanup = null;

	function scrollRail(dir: -1 | 1) {
		if (!scroller) return;
		scroller.scrollBy({
			left: dir * Math.min(scroller.clientWidth * 0.8, 460),
			behavior: 'smooth',
		});
	}

	railPrev?.addEventListener('click', () => scrollRail(-1));
	railNext?.addEventListener('click', () => scrollRail(1));

	// --- Mouse drag-to-swipe on the rail ------------------------------
	// Native touch swipe already works via `overflow-x: auto` +
	// scroll-snap-type on the rail element. This handler adds the same
	// gesture for desktop pointer input using pointer events.
	//
	// Drag activation is delayed until movement crosses the threshold —
	// a bare click (mouse down + up with no significant movement)
	// never calls setPointerCapture and never preventDefault()s a
	// pointermove, so anchor clicks on child cards fire normally.
	if (scroller) {
		let isDown = false;
		let isDragging = false;
		let startX = 0;
		let startScrollLeft = 0;
		let savedSnap = '';
		const DRAG_THRESHOLD_PX = 6;

		scroller.style.cursor = 'grab';

		scroller.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			isDown = true;
			isDragging = false;
			startX = e.clientX;
			startScrollLeft = scroller.scrollLeft;
		});

		scroller.addEventListener('pointermove', (e) => {
			if (!isDown) return;
			const walk = e.clientX - startX;
			if (!isDragging) {
				// Not yet a drag — wait for the threshold before promoting.
				if (Math.abs(walk) < DRAG_THRESHOLD_PX) return;
				isDragging = true;
				savedSnap = scroller.style.scrollSnapType;
				scroller.style.scrollSnapType = 'none';
				scroller.style.cursor = 'grabbing';
				scroller.setPointerCapture(e.pointerId);
			}
			e.preventDefault();
			scroller.scrollLeft = startScrollLeft - walk;
		});

		function endDrag(e: PointerEvent) {
			if (!isDown) return;
			isDown = false;
			if (isDragging) {
				isDragging = false;
				scroller!.style.cursor = 'grab';
				scroller!.style.scrollSnapType = savedSnap;
				if (scroller!.hasPointerCapture(e.pointerId)) {
					scroller!.releasePointerCapture(e.pointerId);
				}
			}
			// If we never crossed the drag threshold, this was a click —
			// let it propagate normally to the anchor child.
		}

		scroller.addEventListener('pointerup', endDrag);
		scroller.addEventListener('pointercancel', endDrag);
	}

	// --- IntersectionObserver: toggle data-inview for animated elements
	// Uses the design's rootMargin (-18% top and bottom) so animations
	// fire once the element is properly in the reading zone, not just
	// touching the viewport edge.
	//
	// Some animations should play once and stay (the client-work card
	// ripple, and the availability icon's drop-and-bounce) — for those,
	// we unobserve after firing so data-inview never gets removed on
	// scroll-out and the animation doesn't reset each time the section
	// re-enters view. Other animations (heading tint, name sweep, arrow
	// nudge, email sweep) re-arm on re-entry.
	// Every homepage scroll animation is treated as one-and-done — the
	// entry effect plays once when the element scrolls into the reading
	// zone, then stays put. No re-fire on scroll back.
	const RUN_ONCE = new Set([
		'track',    // client-work rail card ripple
		'landing',  // About availability icon drop
		'illus',    // Philosophy diagram layer reveal
		'rule',     // About accent rule scale-in
		'head',     // What I do heading tint sweeps
		'name',     // Selected clients staggered tint sweep
		'arrow',    // Bookbag / Cernago ↗ nudge
		'email',    // Contact email gradient sweep
	]);

	// Shared helper: an element counts as "should fire the animation"
	// if it's intersecting the trigger zone OR the user has already
	// scrolled past it entirely (rect.bottom < 0). The scrolled-past
	// case matters because IntersectionObserver only fires on state
	// changes: during a very fast scroll, or on initial page load when
	// the user is already past a section, the observer can end up with
	// isIntersecting=false and the animation never plays.
	function shouldFire(entry: IntersectionObserverEntry) {
		return entry.isIntersecting || entry.boundingClientRect.bottom < 0;
	}

	const io = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				const anim = entry.target.getAttribute('data-anim') ?? '';
				const isRunOnce = RUN_ONCE.has(anim);
				if (shouldFire(entry)) {
					entry.target.setAttribute('data-inview', '1');
					if (isRunOnce) io.unobserve(entry.target);
				} else if (!isRunOnce) {
					entry.target.removeAttribute('data-inview');
				}
			}
		},
		{ threshold: 0, rootMargin: '-18% 0px -18% 0px' }
	);

	// Second, deeper-triggering observer just for the client-work track.
	// The default -18% bottom rootMargin fires the ripple as the track
	// only just crests the bottom of the viewport — often the user is
	// still scrolling past it and misses the entry. -40% bottom means
	// the track must be well into the reading zone before firing, so
	// the ripple plays where the user is actually looking.
	const trackIo = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (shouldFire(entry)) {
					entry.target.setAttribute('data-inview', '1');
					trackIo.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0, rootMargin: '0px 0px -40% 0px' }
	);

	// Third, earlier-triggering observer for the About availability
	// block — its rule and landing icon should attract the eye the
	// moment the block appears in view, not wait for the reader to
	// dwell in the middle-of-viewport reading zone. rootMargin
	// -5% bottom = fires as soon as ~95% of the viewport is available,
	// which for the availability block means "just about visible" is
	// enough to start the choreography.
	const availabilityIo = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (shouldFire(entry)) {
					entry.target.setAttribute('data-inview', '1');
					availabilityIo.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0, rootMargin: '0px 0px -5% 0px' }
	);

	function watch() {
		document.querySelectorAll('[data-anim]').forEach((el) => {
			if (el.hasAttribute('data-inview')) return; // already fired

			const anim = el.getAttribute('data-anim');

			// If the element is already above the viewport by the time
			// the observer is being set up, fire it immediately — no
			// scroll event will trigger the observer for something
			// the user has already passed. This is the single-page-load
			// case; the observer callbacks handle the mid-scroll case
			// via shouldFire() above.
			const rect = el.getBoundingClientRect();
			if (rect.bottom < 0) {
				el.setAttribute('data-inview', '1');
				return;
			}

			if (anim === 'track') {
				trackIo.observe(el);
				return;
			}
			if (anim === 'rule' || anim === 'landing') {
				availabilityIo.observe(el);
				return;
			}
			io.observe(el);
		});
	}
	const watchTimer = setTimeout(watch, 600);
	watch();

	// Expose cleanup for the next navigation. DOM listeners on
	// scroller / rail buttons don't need explicit removal — those
	// elements are garbage-collected when the next page swap
	// replaces them. Observers do need explicit disconnection
	// because they hold references to their observed targets.
	previousCleanup = () => {
		io.disconnect();
		trackIo.disconnect();
		availabilityIo.disconnect();
		clearTimeout(watchTimer);
	};
	} // end init()

	// Astro fires astro:page-load on the initial page load AND after
	// every ClientRouter navigation. Registering here covers both.
	// Also call init() eagerly in case the module loads AFTER the
	// initial page-load event has already fired.
	document.addEventListener('astro:page-load', init);
	init();
</script>
