---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string; // optional absolute or root-relative path for og:image
	type?: 'website' | 'article';
}

const {
	title = 'Ben Young — Design and AI consultant',
	description = 'Twenty years designing for the web. Design and AI consultant based in Bournemouth, UK. Founder of Cernago and co-founder of Bookbag. Available two or three days a week for fractional and remote engagements.',
	image,
	type = 'website',
} = Astro.props;

// Absolute URLs for the OpenGraph / Twitter tags. Astro.site is set
// in astro.config.mjs; falls back to Astro.url.origin at build time.
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = image ? new URL(image, siteOrigin).href : undefined;

// JSON-LD structured data. Person + WebSite in one @graph so search
// engines can link them via @id. Emitted on every page so the site's
// author identity is discoverable from any entry point.
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${siteOrigin}/#ben`,
			name: 'Ben Young',
			givenName: 'Ben',
			familyName: 'Young',
			jobTitle: 'Design and AI consultant',
			description:
				'Twenty-one years designing for the web. Design, UX and AI consultant based in Bournemouth, UK. Founder of Cernago and co-founder of Bookbag. Available fractional and remote, two or three days a week.',
			url: siteOrigin,
			email: 'mailto:ben@benyoung.me',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Bournemouth',
				addressCountry: 'GB',
			},
			knowsAbout: [
				'User experience design',
				'Product design',
				'AI-assisted development',
				'AI automation and multi-agent workflows',
				'UX and website audits',
				'AI search visibility (AEO and GEO)',
			],
		},
		{
			'@type': 'WebSite',
			'@id': `${siteOrigin}/#website`,
			url: siteOrigin,
			name: 'Ben Young',
			description:
				'Design, UX and AI consultant. Twenty-one years in digital. Fractional and remote engagements from Bournemouth, UK.',
			author: { '@id': `${siteOrigin}/#ben` },
			inLanguage: 'en-GB',
		},
	],
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="author" content="Ben Young" />
		<meta name="theme-color" content="#17181b" />
		<meta name="color-scheme" content="dark" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- Favicon (SVG, works in Chrome, Firefox, Safari 12+, Edge).
		     A raster apple-touch-icon.png (180x180) is still needed for
		     iOS Add-to-Home-Screen; deferred pending a designer pass. -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- OpenGraph -->
		<meta property="og:site_name" content="Ben Young" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="en_GB" />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<!-- Twitter -->
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<!-- JSON-LD structured data (Person + WebSite linked by @id). -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<!-- Umami analytics (cloud-hosted). Cookieless, no personal data
		     stored client-side, no cross-site tracking. is:inline stops
		     Astro from bundling the tag so the src attribute is served
		     verbatim to the browser. -->
		<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="b05f774c-8cd5-4e54-bba3-3e085d6ee05a"></script>

		<!-- ClientRouter enables Astro's built-in View Transitions
		     between page navigations (Homepage → /work → case study).
		     Falls back to normal navigation in browsers without support. -->
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>
